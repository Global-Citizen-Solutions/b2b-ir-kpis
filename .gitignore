# Secrets
.env

# Python
__pycache__/
*.pyc
.venv/
venv/

# The generated dataset holds real client/intermediary names and HubSpot
# links, so it is never committed: dashboard-data.yml regenerates it in CI and
# bakes the page into the Azure image. Rebuild locally with generate_report.py.
dashboard/data/*.json

# Dashboard build output - a throwaway folder (rebuild any time with
# dashboard/build_dashboard.py). outputs/index.html is the plaintext page.
# outputs/vercel/index.html is the old password-locked build, left in place
# only until the Vercel project is retired; nothing updates it any more.
outputs/
dashboard/.vercel/

